# Copy this file to .env at the project root before running:
#   docker compose -f docker-compose.prod.yml up --build
#
# For local (non-Docker) development, use backend/.env.example instead -
# it has the same variables with localhost-appropriate defaults.

ENVIRONMENT=production
DEBUG=false

# --- MongoDB ---
# docker-compose.prod.yml overrides MONGODB_URL to point at the `mongo`
# service automatically - you don't need to set it here unless you're
# using an external/managed MongoDB instead of the bundled container.
DATABASE_NAME=smart_timetable_db

# --- JWT / Auth ---
# Generate real values with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-real-random-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# --- CORS ---
# The public origin(s) your frontend is actually served from in
# production, e.g. https://timetable.yourcollege.edu
CORS_ORIGINS=https://timetable.yourcollege.edu

# --- First-run Super Admin bootstrap ---
# Used exactly once, the very first time the app starts against an empty
# database. Change this password immediately after your first login.
SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_EMAIL=admin@college.edu
SUPER_ADMIN_PASSWORD=CHANGE-ME-before-first-deploy

# --- Rate limiting ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=120/minute

# --- Logging ---
LOG_LEVEL=INFO

# --- College identity (used in generated documents in a later phase) ---
COLLEGE_NAME=Your College Name

# =========================================================================
# Reserved for future phases - present here so the .env shape is stable,
# not because anything in the current codebase reads these yet:
# =========================================================================

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@college.edu

# AI_PROVIDER=
# AI_API_KEY=
