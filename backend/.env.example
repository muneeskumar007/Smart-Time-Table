# Copy this file to .env in the backend/ folder for standalone local
# development (running `uvicorn app.main:app --reload` directly, with
# MongoDB running on your machine or reachable at the URL below).
#
# Running via Docker Compose instead? Use the root-level .env.example -
# docker-compose.yml reads that one, not this one.

ENVIRONMENT=development
DEBUG=true

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_timetable_db

# Generate a real one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-1f8e6f3b9c2a4d5e7f0a1b2c3d4e5f60
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# The frontend's Vite dev server origin (see frontend/vite.config.js)
CORS_ORIGINS=http://localhost:5173

# First-run bootstrap account - change this password immediately after
# your first login.
SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_EMAIL=admin@college.edu
SUPER_ADMIN_PASSWORD=Admin@123456

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=120/minute

LOG_LEVEL=INFO
